<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.koreate.cinema.mapper.MovieListMapper">

<select id="selectMovieList" resultType="net.koreate.cinema.vo.MovieVO">
    SELECT * FROM final_movie ORDER BY movie_code DESC
</select>

<select id="getMovie" resultType="net.koreate.cinema.vo.MovieVO">
    SELECT * FROM movie WHERE movie_id = #{movie_id}
</select>

<delete id="deleteMovie">
    DELETE FROM movie WHERE movie_id = #{movie_id}
</delete>

</mapper>