<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="TheaterMapper">
	<select id="theaterList" resultType="net.koreate.cinema.vo.TheaterVO">
		SELECT * FROM theater
	</select>
	
	<select id="branchList" parameterType="int" resultType="net.koreate.cinema.vo.BranchVO">
		SELECT * FROM theater_branch WHERE theater_code = #{theaterCode}
	</select>
</mapper>
